# Fixed private upstreams. The browser talks only to the Nuxt same-origin BFF.
NUXT_API_UPSTREAM=http://127.0.0.1:8080/api
NUXT_SOCKET_UPSTREAM=http://127.0.0.1:3334
# Exact origins, comma-separated; no wildcard or inferred forwarded Host.
NUXT_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate a random secret, keep outside Git: openssl rand -base64 32
NUXT_APP_SECRET=
NUXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Existing Cloudflare widget. Sitekey is public; secret belongs in your secret manager.
NUXT_PUBLIC_TURNSTILE_ENABLED=true
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFwyH9xyrHzMmwps
NUXT_TURNSTILE_SECRET=
# Exact frontend hostnames, not URLs. Confirm these in your existing widget settings.
# Production must not include localhost/127.0.0.1.
NUXT_TURNSTILE_HOSTNAMES=
# Isolated loopback-only fixtures may explicitly set ENABLED=false; never production.

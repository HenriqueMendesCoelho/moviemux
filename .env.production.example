# Safe template only: replace internal service names and confirm the public domain.
# Inject real secret values through the deployment platform; never commit them.
NODE_ENV=production
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
NUXT_API_UPSTREAM=http://gateway:8080/api
NUXT_SOCKET_UPSTREAM=http://events:3334
NUXT_TRUSTED_ORIGINS=https://www.moviemux.com
# REQUIRED private secret: random, at least 32 characters; stable across restarts.
NUXT_APP_SECRET=
NUXT_PUBLIC_TURNSTILE_ENABLED=true
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFwyH9xyrHzMmwps
# REQUIRED private secret from the existing widget, not a new widget.
NUXT_TURNSTILE_SECRET=
# Confirm this exact hostname is configured on the existing widget.
NUXT_TURNSTILE_HOSTNAMES=www.moviemux.com
NUXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# Secure defaults, shown explicitly; do not weaken them in production.
NUXT_SESSION_COOKIE_SECURE=true
NUXT_SESSION_COOKIE_HTTP_ONLY=true
NUXT_SESSION_COOKIE_SAME_SITE=lax
NUXT_SESSION_COOKIE_PATH=/
